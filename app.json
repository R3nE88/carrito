{
  "expo": {
    "name": "Carrito",
    "slug": "carrito",
    "version": "1.0.0",
    "scheme": "carrito",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.r3ne88.carrito",
      "infoPlist": {
        "NSCameraUsageDescription": "Carrito usa la cámara para leer el código de barras de tus productos y sumarlos a tu compra. No se toman ni guardan fotos."
      }
    },
    "android": {
      "package": "com.r3ne88.carrito",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Carrito usa la cámara para leer el código de barras de tus productos y sumarlos a tu compra. No se toman ni guardan fotos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
